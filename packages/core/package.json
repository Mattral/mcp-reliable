{
  "name": "@mattral/core",
  "version": "1.2.1",
  "description": "Shared data model, health scoring, and drift detection algorithms for mcp-reliable",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mattral/mcp-reliable.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Mattral/mcp-reliable#readme",
  "bugs": {
    "url": "https://github.com/Mattral/mcp-reliable/issues"
  },
  "author": "Min Htet Myet (Mattral)",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "reliability",
    "observability",
    "health-score",
    "drift-detection"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
