{
  "name": "@mattral/agent-interface",
  "version": "1.2.0",
  "description": "Agent-facing MCP interface exposing mcp-reliable's own health, drift, and recommendation data as MCP tools",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mattral/mcp-reliable.git",
    "directory": "packages/agent-interface"
  },
  "homepage": "https://github.com/Mattral/mcp-reliable#readme",
  "bugs": {
    "url": "https://github.com/Mattral/mcp-reliable/issues"
  },
  "author": "Min Htet Myet (Mattral)",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "reliability",
    "observability"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
