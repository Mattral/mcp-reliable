{
  "name": "@mattral/storage",
  "version": "1.2.1",
  "description": "SQLite-backed persistence layer for mcp-reliable",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mattral/mcp-reliable.git",
    "directory": "packages/storage"
  },
  "homepage": "https://github.com/Mattral/mcp-reliable#readme",
  "bugs": {
    "url": "https://github.com/Mattral/mcp-reliable/issues"
  },
  "author": "Min Htet Myet (Mattral)",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "reliability",
    "observability",
    "sqlite"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist *.tsbuildinfo",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@mattral/core": "^1.2.1",
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "typescript": "^5.7.3"
  }
}
