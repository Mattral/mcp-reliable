{
  "name": "@mattral/server",
  "version": "1.0.0",
  "description": "REST API exposing mcp-reliable's stored reliability data, and serves the web dashboard",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mattral/mcp-reliable.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/Mattral/mcp-reliable#readme",
  "bugs": {
    "url": "https://github.com/Mattral/mcp-reliable/issues"
  },
  "author": "Min Htet Myet (Mattral)",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "reliability",
    "observability",
    "rest-api",
    "dashboard"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mcp-reliable-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "dashboard-dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/index.js",
    "clean": "rimraf dist dashboard-dist *.tsbuildinfo",
    "prepublishOnly": "node scripts/copy-dashboard.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@mattral/core": "^1.0.0",
    "@mattral/storage": "^1.0.0",
    "hono": "^4.12.30"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
