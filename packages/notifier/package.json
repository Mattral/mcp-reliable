{
  "name": "@mattral/notifier",
  "version": "1.2.2",
  "description": "Webhook and Slack delivery for mcp-reliable alerts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mattral/mcp-reliable.git",
    "directory": "packages/notifier"
  },
  "homepage": "https://github.com/Mattral/mcp-reliable#readme",
  "bugs": {
